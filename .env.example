NODE_ENV=production
HOST=0.0.0.0
PORT=3000
COOKIE_SECURE=true

# Telegram library bot (never commit the real token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Optional. Leave default unless you run your own Local Bot API server.
TELEGRAM_BOT_API_BASE=https://api.telegram.org
# Docker: set true and fill API credentials to enable large Telegram files.
TELEGRAM_LOCAL_API=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Must be on the same persistent disk as DATA_DIR.
TELEGRAM_LOCAL_DIR=/var/data/telegram
# One-time cloud logOut; completion is recorded on the persistent disk.
TELEGRAM_MIGRATE_FROM_CLOUD=false

# Creator Tools are protected server-side by room ownership.
# No secret is required for the owner-only Creator Tools panel.
